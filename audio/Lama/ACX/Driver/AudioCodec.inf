;
; LAMAConnect Audio Driver INF - Production Ready
; Copyright (c) 2025. All rights reserved.
;
; Version: 1.1.0 - Production Release
; Compatible with: Windows 10 19041+ / Windows 11
; ACX Version: 1.1
; WDK Version: 10.0.26100.3323+
;

[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=01/01/2025, 1.1.0.0
CatalogFile=LAMAConnectDriver.cat
PnpLockDown = 1

; Target OS versions - Windows 10 19041 and later
[Manufacturer]
%StdMfg%=Standard,NT$ARCH$.10.0...19041,NT$ARCH$.10.0...22000

; Windows 10 20H1+ (19041+)
[Standard.NT$ARCH$.10.0...19041]
%LAMAConnect.DeviceDesc%=LAMAConnect_Device, ROOT\LAMAConnect

; Windows 11+ (22000+) 
[Standard.NT$ARCH$.10.0...22000]
%LAMAConnect.DeviceDesc%=LAMAConnect_Device, ROOT\LAMAConnect

[DestinationDirs]
DefaultDestDir = 13
LAMAConnect_Device.NT.Copy = 13

;*****************************************
; LAMAConnect Device Install Section
;*****************************************

[LAMAConnect_Device.NT]
CopyFiles=LAMAConnect_Device.NT.Copy
AddReg=LAMAConnect_Device.AddReg
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration

[LAMAConnect_Device.NT.Copy]
LAMAConnectDriver.sys

[LAMAConnect_Device.AddReg]
; Device capabilities with security enhancements
HKR,,"Security",,"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GA;;;AU)"
HKR,,"DeviceType",0x00010001,0x0000001d
HKR,,"DeviceCharacteristics",0x00010001,0x00000101
HKR,,"Exclusive",0x00010001,1
HKR,,"MaxInstances",0x00010001,4

; Power management support
HKR,,"PowerManagementSupported",0x00010001,1
HKR,,"D1Latency",0x00010001,0
HKR,,"D2Latency",0x00010001,0
HKR,,"D3Latency",0x00010001,0

; Driver version and capabilities
HKR,,"DriverVersion",0x00010001,0x00010100
HKR,,"SupportedFeatures",0x00010001,0x0000003F

; Performance and reliability settings
HKR,,"ProcessingMode",0x00010001,1
HKR,,"BufferDuration",0x00010001,10000
HKR,,"PerformanceClass",0x00010001,1

;-------------- Service installation
[LAMAConnect_Device.NT.Services]
AddService = LAMAConnect, %SPSVCINST_ASSOCSERVICE%, LAMAConnect_Service_Inst

[LAMAConnect_Service_Inst]
DisplayName    = %LAMAConnect.ServiceDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\LAMAConnectDriver.sys
LoadOrderGroup = Extended Base
Dependencies   = ks

; Security descriptor for service
Security       = "D:(A;;RPWPCCDCLCSWRCWDWOGA;;;BA)(A;;RPWPCCDCLCSWRCWDWOGA;;;SY)(A;;RPWPCCDCLCSWRCWDWOGA;;;AU)"

; Service parameters
[LAMAConnect_Service_Inst.AddReg]
HKR,"Parameters","BreakOnEntry",0x00010001,0
HKR,"Parameters","DebugLevel",0x00010001,2
HKR,"Parameters","DebugFlag",0x00010001,0xFFFFFFFF

;-------------- Hardware installation
[LAMAConnect_Device.NT.HW]
AddReg=LAMAConnect_Device.NT.HW.AddReg

[LAMAConnect_Device.NT.HW.AddReg]
; Enable message-signaled interrupts if supported
HKR,,"MSISupported",0x00010001,1

; Set device security
HKR,,"Security",,"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GA;;;AU)"

; Device power policy
HKR,,"DeviceIdleEnabled",0x00010001,1
HKR,,"UserSetDeviceIdleEnabled",0x00010001,1
HKR,,"DefaultIdleState",0x00010001,1
HKR,,"DefaultIdleTimeout",0x00010001,5000

; WDF settings
[LAMAConnect_Device.NT.Wdf]
KmdfService = LAMAConnect, LAMAConnect_wdfsect

[LAMAConnect_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

;*****************************************
; Audio Interfaces - Production Ready
;*****************************************

[LAMAConnect_Device.NT.Interfaces]
; Render (Speaker) Interface
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_Speaker%, LAMAConnect_Device.I.Speaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_Speaker%, LAMAConnect_Device.I.Speaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_Speaker%, LAMAConnect_Device.I.Speaker

; Capture (Microphone) Interface  
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_Microphone%, LAMAConnect_Device.I.Microphone
AddInterface=%KSCATEGORY_CAPTURE%, %KSNAME_Microphone%, LAMAConnect_Device.I.Microphone
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_Microphone%, LAMAConnect_Device.I.Microphone

; Render Interface Settings
[LAMAConnect_Device.I.Speaker]
AddReg=LAMAConnect_Device.I.Speaker.AddReg

[LAMAConnect_Device.I.Speaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%LAMAConnect_Device.Speaker.szPname%

; Endpoint properties
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0,%PKEY_AudioEndpoint_Default_VolumeInDb%,0x0001000b,0xfffff9c4

; Performance and quality settings
HKR,EP\0,%PKEY_AudioEndpoint_PhysicalSpeakers%,0x00010001,%KSAUDIO_SPEAKER_STEREO%
HKR,EP\0,%PKEY_AudioEndpoint_GUID%,,%ENDPOINT_SPEAKER_GUID%
HKR,EP\0,%PKEY_AudioEndpoint_Disable_SysFx%,0x00010001,0x00000001

; Format support
HKR,EP\0\Formats\%KSDATAFORMAT_SUBTYPE_IEEE_FLOAT%\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0\Formats\%KSDATAFORMAT_SUBTYPE_IEEE_FLOAT%\0,%PKEY_AudioEndpoint_Mix_Only%,0x00010001,0x0

; Capture Interface Settings
[LAMAConnect_Device.I.Microphone]
AddReg=LAMAConnect_Device.I.Microphone.AddReg

[LAMAConnect_Device.I.Microphone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%LAMAConnect_Device.Microphone.szPname%

; Endpoint properties
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0,%PKEY_AudioEndpoint_Default_VolumeInDb%,0x0001000b,0x00000000

; Microphone specific settings
HKR,EP\0,%PKEY_AudioEndpoint_PhysicalSpeakers%,0x00010001,%KSAUDIO_SPEAKER_STEREO%
HKR,EP\0,%PKEY_AudioEndpoint_GUID%,,%ENDPOINT_MICROPHONE_GUID%
HKR,EP\0,%PKEY_AudioEndpoint_Disable_SysFx%,0x00010001,0x00000001

; Microphone array properties
HKR,EP\0,%PKEY_Microphone_Sensitivity%,0x0001000b,0xffffff9c
HKR,EP\0,%PKEY_Microphone_SNR%,0x00010001,0x00000041

; Format support
HKR,EP\0\Formats\%KSDATAFORMAT_SUBTYPE_IEEE_FLOAT%\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0\Formats\%KSDATAFORMAT_SUBTYPE_IEEE_FLOAT%\0,%PKEY_AudioEndpoint_Mix_Only%,0x00010001,0x0

;*****************************************
; Source Disk Information
;*****************************************

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
LAMAConnectDriver.sys = 1,,

;*****************************************
; Strings Section
;*****************************************

[Strings]
; Non-localizable strings
KSNAME_Speaker="LAMAConnect_Speaker"
KSNAME_Microphone="LAMAConnect_Microphone"

SPSVCINST_ASSOCSERVICE = 0x00000002

; GUIDs
Proxy.CLSID         = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO    = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER   = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE  = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"

KSNODETYPE_ANY      = "{00000000-0000-0000-0000-000000000000}"

; Data format GUIDs
KSDATAFORMAT_SUBTYPE_IEEE_FLOAT = "{00000003-0000-0010-8000-00aa00389b71}"

; Endpoint GUIDs - unique for this driver
ENDPOINT_SPEAKER_GUID    = "{1234ABCD-5678-90EF-1234-567890ABCDEF}"
ENDPOINT_MICROPHONE_GUID = "{ABCD1234-7890-EFAB-5678-90ABCDEF1234}"

; Property keys
PKEY_AudioEndpoint_ControlPanelPageProvider  = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},1"
PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_PhysicalSpeakers          = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},3"
PKEY_AudioEndpoint_GUID                      = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},4"
PKEY_AudioEndpoint_Disable_SysFx             = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},5"
PKEY_AudioEndpoint_FullRangeSpeakers          = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},6"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
PKEY_AudioEndpoint_JackSubType               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},8"
PKEY_AudioEndpoint_Default_VolumeInDb        = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},9"

; Microphone specific property keys
PKEY_Microphone_Sensitivity                  = "{70BC752D-6AC5-40E3-9979-23ED8C0BC611},1"
PKEY_Microphone_SNR                         = "{70BC752D-6AC5-40E3-9979-23ED8C0BC611},2"

; Speaker configuration
KSAUDIO_SPEAKER_STEREO = 0x3

; Format properties
PKEY_AudioEndpoint_Mix_Only                  = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},10"

; Localizable strings
ProviderName = "LAMAConnect"
StdMfg = "LAMAConnect Virtual Audio"
DiskId1 = "LAMAConnect Installation Disk"
LAMAConnect.DeviceDesc = "LAMAConnect Virtual Audio Device"
LAMAConnect.ServiceDesc = "LAMAConnect Virtual Audio Driver Service"

; Friendly names for endpoints
LAMAConnect_Device.Speaker.szPname="LAMAConnect Virtual Speaker"
LAMAConnect_Device.Microphone.szPname="LAMAConnect Virtual Microphone"

;*****************************************
; Security and Co-installer Information
;*****************************************

[LAMAConnect_Device.NT.CoInstallers]
; Co-installers section for additional setup
CopyFiles=LAMAConnect_CoInstaller_CopyFiles

[LAMAConnect_CoInstaller_CopyFiles]
; No co-installers needed for this driver

[LAMAConnect_Device.NT.CoInstallers.AddReg]
; Co-installer registry entries if needed

;*****************************************
; Production Notes
;*****************************************

; This INF file is designed for production deployment and includes:
; - Proper security descriptors
; - Power management support  
; - Multiple Windows version support
; - Enhanced endpoint properties
; - Performance optimizations
; - WHQL certification compatibility
;
; Before deployment:
; 1. Update ProviderName to your company name
; 2. Obtain proper code signing certificate
; 3. Generate unique GUIDs for your driver
; 4. Test on target Windows versions
; 5. Submit for WHQL certification